<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QiblaFinder" parent="android:Theme.Material.NoActionBar">
        <!-- Enable edge-to-edge by default -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Samsung/One UI specific configurations -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:fitsSystemWindows">false</item>
        <!-- Support display cutouts (attribute available only since API 27). Kept in
             sync with values-v27/styles.xml: `night` outranks the API-level qualifier,
             so a dark-mode API 27-29 device would otherwise lose cutout handling.
             tools:targetApi silences the NewApi lint check (values-night also applies
             to API < 27, where unknown attributes are ignored at runtime). -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <!-- Force immersive mode -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
